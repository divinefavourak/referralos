# ReferralOS Environment Configuration
# PostgreSQL Database (Neon or local, PostGIS enabled)
DATABASE_URL="postgresql://referralos_user:referralos_pass@localhost:5432/referralos_db?sslmode=require"

# Redis Cache & Distributed Lock Manager (Upstash or local)
REDIS_URL="redis://localhost:6379"

# Server Configuration
PORT=8080
HOST="0.0.0.0"
NODE_ENV="development"
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"
API_BASE_URL="http://localhost:8080/api/v1"

# Security & Auth
JWT_SECRET="referralos-super-secret-jwt-signing-key-production-grade"
JWT_EXPIRES_IN="7d"
WEBHOOK_HMAC_SECRET="referralos-webhook-signing-secret"
